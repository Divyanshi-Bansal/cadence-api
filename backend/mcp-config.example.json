{
  "mcpServers": {
    "cadence-api": {
      "command": "npx",
      "args": [
        "ts-node",
        "src/mcp/index.ts"
      ],
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/cadence_db?schema=public",
        "GEMINI_API_KEY": "YOUR_GEMINI_API_KEY",
        "CADENCE_USER_ID": "OPTIONAL_DEFAULT_USER_CUID"
      }
    }
  }
}
